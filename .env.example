# Address of the backend API (no trailing slash), for local development: the backend started
# with `npm run dev` in the backend folder. This dashboard runs on http://localhost:5174
# (the backend's CORS_ORIGINS lists it).
#
# Not used on the VPS: the Docker image is built with an empty value, so the dashboard calls
# /api on its own address and its Nginx forwards that to the backend (see docker-compose.yml).
VITE_API_BASE_URL=http://localhost:4000
